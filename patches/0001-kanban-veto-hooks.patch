+        task_ids=[tid], result=None, summary="ok", metadata=None, force=False,
+    )
+    assert kc._cmd_complete(args) == 1
+    assert "refused: gate sem veredito" in capsys.readouterr().err
+    with kbc.connect_closing() as conn:
+        assert kb.get_task(conn, tid).status != "done"
+
+
+def test_cli_complete_passes_cli_actor(kanban_home, register):
+    from hermes_cli import kanban as kc
+
+    seen = []
+    register("kanban_pre_complete", lambda **kw: seen.append(kw))
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="t")
+    args = argparse.Namespace(
+        task_ids=[tid], result=None, summary="ok", metadata=None, force=False,
+    )
+    assert kc._cmd_complete(args) == 0
+    assert seen[0]["actor"].startswith("cli:")
