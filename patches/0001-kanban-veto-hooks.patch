+++ b/tests/hermes_cli/test_kanban_veto_hooks.py
@@ -0,0 +1,340 @@
+"""Tests for the ``kanban_pre_claim`` / ``kanban_pre_complete`` veto hooks.
+
+Unlike the observer hooks (``kanban_task_claimed`` & co.), these two fire BEFORE the
+board write and may refuse the transition by returning ``{"refuse": "<reason>"}``.
+A plugin that raises, times out, or returns anything else must never block the board
+(fail-open): only an explicit refusal vetoes.
+"""
+
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+
+
+class _Lazy:
+    """Resolve a hermes_cli module at use time, not collection time.
+
+    Some kanban tests purge every ``hermes_cli*`` entry from ``sys.modules`` to re-import
+    under a fresh HERMES_HOME. A module object bound at collection time would then be a
+    stale copy whose plugin registry is not the one ``kanban_db`` fires through, and the
+    hook callbacks registered here would silently never run."""
+
+    def __init__(self, name: str):
+        self._name = name
+
+    def __getattr__(self, attr):
+        return getattr(importlib.import_module(self._name), attr)
+
+
+kb = _Lazy("hermes_cli.kanban_db")
+kbc = _Lazy("hermes_cli.kanban_db_connect")
+plugins = _Lazy("hermes_cli.plugins")
+
+
+@pytest.fixture
+def kanban_home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    kb.init_db()
+    return home
+
+
+@pytest.fixture
+def register():
+    """Register a hook callback on the plugin manager's registry; restored afterward."""
+    mgr = plugins.get_plugin_manager()
+    saved = {k: list(v) for k, v in mgr._hooks.items()}
+
+    def _register(hook, callback):
+        mgr._hooks.setdefault(hook, []).append(callback)
+
+    try:
+        yield _register
+    finally:
+        mgr._hooks = saved
+
+
+def _kinds(conn, tid):
+    return [e.kind for e in kb.list_events(conn, tid)]
+
+
+def test_hooks_are_valid_and_not_fail_closed():
+    from hermes_cli import plugins_dispatch
+
+    assert "kanban_pre_claim" in plugins.VALID_HOOKS
+    assert "kanban_pre_complete" in plugins.VALID_HOOKS
+    assert "kanban_pre_claim" not in plugins_dispatch._HOOK_TIMEOUT_FAIL_CLOSED_HOOKS
+    assert "kanban_pre_complete" not in plugins_dispatch._HOOK_TIMEOUT_FAIL_CLOSED_HOOKS
+
+
+# --- kanban_pre_claim ---------------------------------------------------------
+
+def test_pre_claim_refusal_keeps_task_ready(kanban_home, register):
+    register("kanban_pre_claim", lambda **kw: {"refuse": "resource matrix/_run busy"})
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="deploy")
+        assert kb.claim_task(conn, tid) is None
+        assert kb.get_task(conn, tid).status == "ready"
+        assert _kinds(conn, tid).count("claim_refused") == 1
+        assert kb.claim_task(conn, tid) is None
+        assert _kinds(conn, tid).count("claim_refused") == 1  # dedupe
+
+
+def test_pre_claim_refusal_event_payload_and_no_run_opened(kanban_home, register):
+    register("kanban_pre_claim", lambda **kw: {"refuse": "busy"})
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="deploy")
+        assert kb.claim_task(conn, tid) is None
+        refused = [e for e in kb.list_events(conn, tid) if e.kind == "claim_refused"]
+        assert refused[0].payload == {"reason": "busy", "by": "plugin"}
+        task = kb.get_task(conn, tid)
+        assert task.current_run_id is None
+        assert task.claim_lock is None
+        assert "claimed" not in _kinds(conn, tid)
+
+
+def test_pre_claim_new_reason_logs_new_event(kanban_home, register):
+    reason = {"v": "first"}
+    register("kanban_pre_claim", lambda **kw: {"refuse": reason["v"]})
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="deploy")
+        assert kb.claim_task(conn, tid) is None
+        reason["v"] = "second"
+        assert kb.claim_task(conn, tid) is None
+        assert kb.claim_task(conn, tid) is None
+        refused = [e.payload["reason"] for e in kb.list_events(conn, tid) if e.kind == "claim_refused"]
+        assert refused == ["first", "second"]
+
+
+def test_pre_claim_passes_documented_kwargs(kanban_home, register):
+    seen = []
+    register("kanban_pre_claim", lambda **kw: seen.append(kw))
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="t", assignee="worker")
+        assert kb.claim_task(conn, tid, claimer="host:1") is not None
+    assert len(seen) == 1
+    kw = seen[0]
+    assert kw["task_id"] == tid
+    assert kw["assignee"] == "worker"
+    assert kw["claimer"] == "host:1"
+    assert "board" in kw and "workspace_path" in kw
+
+
+def test_pre_claim_callback_error_fails_open(kanban_home, register):
+    def boom(**kw):
+        raise RuntimeError("x")
+
+    register("kanban_pre_claim", boom)
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="t")
+        assert kb.claim_task(conn, tid) is not None
+
+
+def test_pre_claim_invoke_failure_fails_open(kanban_home, register, monkeypatch):
+    register("kanban_pre_claim", lambda **kw: {"refuse": "never reached"})
+    from hermes_cli import lifecycle
+
+    def broken_invoke(*a, **k):
+        raise RuntimeError("dispatch exploded")
+
+    monkeypatch.setattr(lifecycle, "invoke_hook", broken_invoke)
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="t")
+        assert kb.claim_task(conn, tid) is not None
+
+
+@pytest.mark.parametrize("ret", ["no", {"refuse": ""}, {"refuse": None}, {"other": 1}, {"refuse": 3}])
+def test_pre_claim_malformed_result_is_not_a_refusal(kanban_home, register, ret):
+    register("kanban_pre_claim", lambda **kw: ret)
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="t")
+        assert kb.claim_task(conn, tid) is not None
+
+
+def test_pre_claim_not_fired_when_task_not_ready(kanban_home, register):
+    calls = []
+    register("kanban_pre_claim", lambda **kw: calls.append(kw))
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="t")
+        assert kb.claim_task(conn, tid) is not None
+        assert len(calls) == 1
+        assert kb.claim_task(conn, tid) is None  # already running
+        assert len(calls) == 1
+
+
+# --- kanban_pre_complete ------------------------------------------------------
+
+def test_pre_complete_refusal_raises_with_reason(kanban_home, register):
+    register("kanban_pre_complete", lambda **kw: {"refuse": "gate sem veredito"})
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="gate")
+        with pytest.raises(kb.CompletionRefused) as ei:
+            kb.complete_task(conn, tid, summary="ok", actor="cli:della")
+        assert ei.value.reason == "gate sem veredito"
+        assert kb.get_task(conn, tid).status != "done"
+        events = [e for e in kb.list_events(conn, tid) if e.kind == "completion_refused"]
+        assert len(events) == 1
+        assert events[0].payload["reason"] == "gate sem veredito"
+        assert events[0].payload["by"] == "plugin"
+        assert "completed" not in _kinds(conn, tid)
+
+
+def test_pre_complete_refusal_keeps_running_task_running(kanban_home, register):
+    register("kanban_pre_complete", lambda **kw: {"refuse": "nope"})
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="t", assignee="w")
+        run_id = kb.claim_task(conn, tid).current_run_id
+        with pytest.raises(kb.CompletionRefused):
+            kb.complete_task(conn, tid, summary="ok", expected_run_id=run_id)
+        task = kb.get_task(conn, tid)
+        assert task.status == "running"
+        assert task.current_run_id == run_id
+
+
+def test_pre_complete_passes_documented_kwargs(kanban_home, register):
+    seen = []
+    register("kanban_pre_complete", lambda **kw: seen.append(kw))
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="t", assignee="w")
+        run_id = kb.claim_task(conn, tid).current_run_id
+        assert kb.complete_task(
+            conn, tid, summary="s", metadata={"k": 1}, expected_run_id=run_id,
+            force=True, actor="alice",
+        )
+    kw = seen[0]
+    assert kw["task_id"] == tid
+    assert kw["assignee"] == "w"
+    assert kw["actor"] == "alice"
+    assert kw["force"] is True
+    assert kw["summary"] == "s"
+    assert kw["metadata"] == {"k": 1}
+    assert kw["run_id"] == run_id
+    assert "board" in kw
+
+
+def test_pre_complete_callback_error_fails_open(kanban_home, register):
+    def boom(**kw):
+        raise RuntimeError("x")
+
+    register("kanban_pre_complete", boom)
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="t")
+        assert kb.complete_task(conn, tid, summary="ok")
+        assert kb.get_task(conn, tid).status == "done"
+
+
+def test_pre_complete_not_fired_for_unknown_task(kanban_home, register):
+    calls = []
+    register("kanban_pre_complete", lambda **kw: calls.append(kw))
+    with kbc.connect_closing() as conn:
+        assert kb.complete_task(conn, "t_missing", summary="ok") is False
+    assert calls == []
+
+
+def test_completion_refused_is_runtime_error():
+    err = kb.CompletionRefused("why")
+    assert isinstance(err, RuntimeError)
+    assert err.reason == "why"
+    assert "why" in str(err)
+
+
+# --- surfaces -----------------------------------------------------------------
+
+def test_cli_complete_prints_refused_and_exits_1(kanban_home, register, capsys):
+    from hermes_cli import kanban as kc
+
+    register("kanban_pre_complete", lambda **kw: {"refuse": "gate sem veredito"})
