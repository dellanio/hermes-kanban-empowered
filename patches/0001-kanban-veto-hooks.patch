+def test_hung_callbacks_fail_open_within_the_cap(kanban_home, register, monkeypatch):
+    mod = importlib.import_module("hermes_cli.plugins")
+    monkeypatch.setattr(mod, "load_config_readonly", lambda: {"kanban": {"veto_hook_timeout_seconds": 0.3}})
+    release = threading.Event()
+
+    def hung(**kw):
+        release.wait(30)  # far longer than the cap
+        return {"refuse": "too late"}
+
+    register("kanban_pre_claim", hung)
+    register("kanban_pre_complete", hung)
+    try:
+        with kbc.connect_closing() as conn:
+            tid = kb.create_task(conn, title="t")
+            started = time.monotonic()
+            assert kb.claim_task(conn, tid) is not None  # fail-open: claim proceeds
+            assert time.monotonic() - started < 5
+            assert "claim_refused" not in _kinds(conn, tid)
+            started = time.monotonic()
+            assert kb.complete_task(conn, tid, summary="ok", force=True)  # fail-open
+            assert time.monotonic() - started < 5
+            assert kb.get_task(conn, tid).status == "done"
+            assert "completion_refused" not in _kinds(conn, tid)
+    finally:
+        release.set()
+
