diff --git a/tests/hermes_cli/test_kanban_veto_hooks.py b/tests/hermes_cli/test_kanban_veto_hooks.py
new file mode 100644
index 0000000000..689db99c37
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_veto_hooks.py
@@ -0,0 +1,446 @@
+"""Tests for the ``kanban_pre_claim`` / ``kanban_pre_complete`` veto hooks.
+
+Unlike the observer hooks (``kanban_task_claimed`` & co.), these two fire BEFORE the
+board write and may refuse the transition by returning ``{"refuse": "<reason>"}``.
+A plugin that raises, times out, or returns anything else must never block the board
+(fail-open): only an explicit refusal vetoes.
+"""
+
+from __future__ import annotations
+
+import argparse
+import importlib
+import importlib.util
+import json
+import sys
+import threading
+import time
+from pathlib import Path
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+
+
+class _Lazy:
+    """Resolve a hermes_cli module at use time, not collection time.
+
+    Some kanban tests purge every ``hermes_cli*`` entry from ``sys.modules`` to re-import
+    under a fresh HERMES_HOME. A module object bound at collection time would then be a
+    stale copy whose plugin registry is not the one ``kanban_db`` fires through, and the
+    hook callbacks registered here would silently never run."""
+
+    def __init__(self, name: str):
+        self._name = name
+
+    def __getattr__(self, attr):
+        return getattr(importlib.import_module(self._name), attr)
+
+
+kb = _Lazy("hermes_cli.kanban_db")
+kbc = _Lazy("hermes_cli.kanban_db_connect")
+plugins = _Lazy("hermes_cli.plugins")
+
+
+@pytest.fixture
+def kanban_home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    kb.init_db()
+    return home
+
+
+@pytest.fixture
+def register():
+    """Register a hook callback on the plugin manager's registry; restored afterward."""
+    mgr = plugins.get_plugin_manager()
+    saved = {k: list(v) for k, v in mgr._hooks.items()}
+
+    def _register(hook, callback):
+        mgr._hooks.setdefault(hook, []).append(callback)
+
+    try:
+        yield _register
+    finally:
+        mgr._hooks = saved
+
+
+def _kinds(conn, tid):
+    return [e.kind for e in kb.list_events(conn, tid)]
+
+
+def test_hooks_are_valid_and_not_fail_closed():
+    from hermes_cli import plugins_dispatch
+
+    assert "kanban_pre_claim" in plugins.VALID_HOOKS
+    assert "kanban_pre_complete" in plugins.VALID_HOOKS
+    assert "kanban_pre_claim" not in plugins_dispatch._HOOK_TIMEOUT_FAIL_CLOSED_HOOKS
+    assert "kanban_pre_complete" not in plugins_dispatch._HOOK_TIMEOUT_FAIL_CLOSED_HOOKS
+
+
+# --- kanban_pre_claim ---------------------------------------------------------
+
+def test_pre_claim_refusal_keeps_task_ready(kanban_home, register):
+    register("kanban_pre_claim", lambda **kw: {"refuse": "resource matrix/_run busy"})
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="deploy")
+        assert kb.claim_task(conn, tid) is None
+        assert kb.get_task(conn, tid).status == "ready"
+        assert _kinds(conn, tid).count("claim_refused") == 1
+        assert kb.claim_task(conn, tid) is None
+        assert _kinds(conn, tid).count("claim_refused") == 1  # dedupe
+
+
+def test_pre_claim_refusal_event_payload_and_no_run_opened(kanban_home, register):
+    register("kanban_pre_claim", lambda **kw: {"refuse": "busy"})
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="deploy")
+        assert kb.claim_task(conn, tid) is None
+        refused = [e for e in kb.list_events(conn, tid) if e.kind == "claim_refused"]
+        assert refused[0].payload == {"reason": "busy", "by": "plugin"}
+        task = kb.get_task(conn, tid)
+        assert task.current_run_id is None
+        assert task.claim_lock is None
+        assert "claimed" not in _kinds(conn, tid)
+
+
+def test_pre_claim_new_reason_logs_new_event(kanban_home, register):
+    reason = {"v": "first"}
+    register("kanban_pre_claim", lambda **kw: {"refuse": reason["v"]})
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="deploy")
+        assert kb.claim_task(conn, tid) is None
+        reason["v"] = "second"
+        assert kb.claim_task(conn, tid) is None
+        assert kb.claim_task(conn, tid) is None
+        refused = [e.payload["reason"] for e in kb.list_events(conn, tid) if e.kind == "claim_refused"]
+        assert refused == ["first", "second"]
+
+
+def test_pre_claim_passes_documented_kwargs(kanban_home, register):
+    seen = []
+    register("kanban_pre_claim", lambda **kw: seen.append(kw))
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="t", assignee="worker")
+        assert kb.claim_task(conn, tid, claimer="host:1") is not None
+    assert len(seen) == 1
+    kw = seen[0]
+    assert kw["task_id"] == tid
+    assert kw["assignee"] == "worker"
+    assert kw["claimer"] == "host:1"
+    assert "board" in kw and "workspace_path" in kw
+
+
+def test_pre_claim_callback_error_fails_open(kanban_home, register):
+    def boom(**kw):
+        raise RuntimeError("x")
+
+    register("kanban_pre_claim", boom)
