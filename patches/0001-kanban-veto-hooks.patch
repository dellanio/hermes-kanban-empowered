+def _kanban_veto_reason(event: str, task_id: str, **fields: Any) -> Optional[str]:
+    """Fire a VETO hook (``kanban_pre_claim`` / ``kanban_pre_complete``) BEFORE the board
+    write; return the first ``{"refuse": "<reason>"}`` a plugin answers with, else ``None``.
+
+    Fail-open: nothing subscribed, a malformed answer, a raising callback or a
+    failure of the dispatch itself all mean "proceed as if unhooked" — only an explicit
+    refusal vetoes, so a broken plugin can never wedge the board."""
+    if not _kanban_observer_consumed(event):
+        return None
+    try:
+        from hermes_cli.lifecycle import invoke_hook
+
+        for result in invoke_hook(event, task_id=task_id, board=get_current_board(), **fields):
+            reason = result.get("refuse") if isinstance(result, dict) else None
+            if isinstance(reason, str) and reason.strip():
+                return reason
+    except Exception as exc:
+        _log.warning("kanban veto hook %s failed (fail-open): %s", event, exc)
+    return None
+
